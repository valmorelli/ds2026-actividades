@baseUrl = http://localhost:3000

### 1. POST /api/auth/registro -> 201 sin passwordHash
POST {{baseUrl}}/api/auth/registro
Content-Type: application/json

{
  "nombre": "Ana Perez",
  "email": "ana@libreria.test",
  "password": "Password123"
}

### 2. POST /api/auth/registro mismo email -> 409
POST {{baseUrl}}/api/auth/registro
Content-Type: application/json

{
  "nombre": "Ana Perez Duplicada",
  "email": "ana@libreria.test",
  "password": "Password123"
}

### 3. POST /api/auth/registro password corta -> 400
POST {{baseUrl}}/api/auth/registro
Content-Type: application/json

{
  "nombre": "Ana Invalida",
  "email": "invalida@libreria.test",
  "password": "corta"
}

### 4. POST /api/auth/login mail que no existe -> 401 Credenciales invalidas
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "noexiste@libreria.test",
  "password": "Password123"
}

### 5. POST /api/auth/login password incorrecto -> 401 Credenciales invalidas
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@libreria.test",
  "password": "PasswordErroneo123"
}

### 6. POST /api/auth/login correcto ADMIN -> 200 con token
# @name loginAdmin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@libreria.test",
  "password": "Admin1234"
}

### Token capturado de ADMIN
@tokenAdmin = {{loginAdmin.response.body.token}}

### Login auxiliar CLIENTE
# @name loginCliente
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "cliente@libreria.test",
  "password": "Cliente1234"
}

### Token capturado de CLIENTE
@tokenCliente = {{loginCliente.response.body.token}}

### 7. GET /api/auth/yo sin header -> 401
GET {{baseUrl}}/api/auth/yo

### 8. GET /api/auth/yo con CLIENTE -> 200
GET {{baseUrl}}/api/auth/yo
Authorization: Bearer {{tokenCliente}}

### 9. POST /api/libros sin header -> 401
POST {{baseUrl}}/api/libros
Content-Type: application/json

{
  "titulo": "Libro Anonimo",
  "precio": 5000,
  "imagen": "https://img.jpg",
  "autorId": 1
}

### 10. POST /api/libros con CLIENTE -> 403
POST {{baseUrl}}/api/libros
Authorization: Bearer {{tokenCliente}}
Content-Type: application/json

{
  "titulo": "Libro de Cliente",
  "precio": 5000,
  "imagen": "https://img.jpg",
  "autorId": 1
}

### 11. POST /api/libros con ADMIN -> 201
POST {{baseUrl}}/api/libros
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{
  "titulo": "Origen",
  "precio": 18500,
  "imagen": "https://images-na.ssl-images-amazon.com/images/S/compressed.photo.goodreads.com/books/1506040854i/35451995.jpg",
  "autorId": 1,
  "disponible": true
}

### 12. GET /api/libros sin header -> 200 publico
GET {{baseUrl}}/api/libros